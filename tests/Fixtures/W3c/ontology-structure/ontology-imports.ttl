# W3C OWL 2 Conformance Test Fixture
# Source: OWL 2 Structural Specification S3.4 - Imports
# Reference: https://www.w3.org/TR/owl2-syntax/#Imports

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex: <http://example.org/> .

ex:myOntology a owl:Ontology ;
    owl:imports ex:baseOntology ;
    owl:imports ex:domainOntology .
