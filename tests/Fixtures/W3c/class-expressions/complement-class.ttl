# W3C OWL 2 Conformance Test Fixture
# Source: OWL 2 Primer Section 4.3 - ObjectComplementOf
# Reference: https://www.w3.org/TR/owl2-syntax/#Complement_of_Class_Expressions

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex: <http://example.org/> .

ex:testOntology a owl:Ontology .

ex:Person a owl:Class .

ex:NonPerson a owl:Class ;
    owl:equivalentClass [
        owl:complementOf ex:Person
    ] .
