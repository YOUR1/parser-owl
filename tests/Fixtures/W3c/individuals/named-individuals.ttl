# W3C OWL 2 Conformance Test Fixture
# Source: OWL 2 Primer Section 5 - Named Individuals
# Reference: https://www.w3.org/TR/owl2-syntax/#Named_Individuals

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex: <http://example.org/> .

ex:testOntology a owl:Ontology .

ex:Person a owl:Class .
ex:Employee a owl:Class .

ex:John a owl:NamedIndividual , ex:Person , ex:Employee ;
    rdfs:label "John Doe" ;
    owl:sameAs ex:JohnDoe .

ex:JohnDoe a owl:NamedIndividual , ex:Person .

ex:Jane a owl:NamedIndividual , ex:Person ;
    rdfs:label "Jane Smith" ;
    owl:differentFrom ex:John .
